			"boundElements": [],
			"updated": 1775959984174,
			"locked": false,
			"text": "Dialogar con agentes IA.\n\nConversaciones donde el\nlenguaje natural funciona\ncomo código. El agente\ndevuelve estructura: lo que\nestaba implícito en el gesto\nse vuelve examinable.",
			"fontSize": 28,
			"fontFamily": 2,
			"textAlign": "center",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Dialogar con agentes IA.\n\nConversaciones donde el lenguaje natural funciona como código. El agente devuelve estructura: lo que estaba implícito en el gesto se vuelve examinable.",
			"lineHeight": 1.15,
			"autoResize": false,
			"index": "ZYV",
			"hasTextLink": false,
			"rawText": "Dialogar con agentes IA.\n\nConversaciones donde el lenguaje natural funciona como código. El agente devuelve estructura: lo que estaba implícito en el gesto se vuelve examinable."
		},
