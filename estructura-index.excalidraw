			"x": 3322.3755440056284,
			"y": -725.5524401770942,
			"width": 257.1121913239632,
			"height": 697.872869318182,
			"angle": 0,
			"strokeColor": "#e03131",
			"backgroundColor": "transparent",
			"fillStyle": "hachure",
			"strokeWidth": 0.5,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
